---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, url } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  skin?: 'default' | 'radar';
}

const { title, description = site.description, skin = 'default' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}, ${site.role}`;
const fonts = [
  'family=Schibsted+Grotesk:wght@400;500;700;800',
  ...(skin === 'radar' ? ['family=Black+Ops+One', 'family=Share+Tech+Mono'] : []),
].join('&');
---

<!doctype html>
<html lang="en-GB" data-skin={skin}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="icon" href={url('favicon.ico')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} rel="stylesheet" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Apply the saved or system theme before paint, and again after each page transition.
      const applyTheme = (doc) => {
        const stored = (() => { try { return localStorage.getItem('theme'); } catch { return null; } })();
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        doc.documentElement.classList.toggle('dark', dark);
      };
      applyTheme(document);
      document.addEventListener('astro:before-swap', (e) => applyTheme(e.newDocument));
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-accent focus:px-3 focus:py-2 focus:text-paper">
      Skip to content
    </a>
    <Header />
    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 sm:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
