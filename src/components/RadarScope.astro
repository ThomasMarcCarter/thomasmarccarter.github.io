---
// Animated radar scope. Each blip flashes as the sweep passes over its bearing.
const SWEEP_SECONDS = 4;
const blips = [
  { bearing: 38, range: 0.62 },
  { bearing: 71, range: 0.34 },
  { bearing: 128, range: 0.8 },
  { bearing: 162, range: 0.5 },
  { bearing: 205, range: 0.72 },
  { bearing: 247, range: 0.28 },
  { bearing: 291, range: 0.58 },
  { bearing: 334, range: 0.84 },
].map(({ bearing, range }) => {
  const rad = ((bearing - 90) * Math.PI) / 180;
  return {
    x: 50 + Math.cos(rad) * range * 46,
    y: 50 + Math.sin(rad) * range * 46,
    delay: (bearing / 360) * SWEEP_SECONDS,
  };
});
---

<div class="scope relative aspect-square w-full max-w-[26rem] rounded-full" style={`--sweep:${SWEEP_SECONDS}s`} aria-hidden="true">
  <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full">
    {[46, 34.5, 23, 11.5].map((r) => <circle cx="50" cy="50" r={r} fill="none" stroke="var(--muted)" stroke-width="0.35" />)}
    <path d="M50 2V98M2 50H98" stroke="var(--muted)" stroke-width="0.25" />
    <path d="M17.5 17.5L82.5 82.5M82.5 17.5L17.5 82.5" stroke="var(--line)" stroke-width="0.25" />
    {Array.from({ length: 72 }, (_, i) => {
      const a = (i * 5 * Math.PI) / 180;
      const inner = i % 6 === 0 ? 43 : 44.5;
      return <line x1={50 + Math.cos(a) * inner} y1={50 + Math.sin(a) * inner} x2={50 + Math.cos(a) * 46} y2={50 + Math.sin(a) * 46} stroke="var(--muted)" stroke-width="0.3" />;
    })}
  </svg>
  <div class="sweep absolute inset-[4%] rounded-full"></div>
  {blips.map((b) => (
    <span class="blip absolute h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full" style={`left:${b.x}%;top:${b.y}%;animation-delay:${b.delay}s`}></span>
  ))}
</div>

<style>
  .scope {
    box-shadow:
      0 0 0 1px var(--muted),
      0 0 60px rgb(57 255 106 / 0.12) inset,
      0 0 40px rgb(57 255 106 / 0.08);
    background: radial-gradient(circle, rgb(57 255 106 / 0.06), transparent 70%);
  }
  .sweep {
    background: conic-gradient(from 0deg, transparent 0deg 290deg, rgb(57 255 106 / 0.04) 290deg, rgb(57 255 106 / 0.5) 360deg);
    animation: sweep var(--sweep) linear infinite;
  }
  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }
  .blip {
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    opacity: 0.12;
    animation: blip var(--sweep) linear infinite;
  }
  @keyframes blip {
    0% {
      opacity: 1;
      scale: 1.5;
    }
    70%,
    100% {
      opacity: 0.12;
      scale: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep,
    .blip {
      animation: none;
    }
    .blip {
      opacity: 0.8;
    }
  }
</style>
