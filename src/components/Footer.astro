---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-6xl px-4 sm:px-8">
  <div class="flex flex-col gap-3 border-t border-line py-8 text-[0.9375rem] text-muted sm:flex-row sm:justify-between">
    <p>© {year} {site.name}</p>
    <p>Built with Astro and Tailwind CSS</p>
  </div>
</footer>
