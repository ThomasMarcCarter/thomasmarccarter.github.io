---
import type { CollectionEntry } from 'astro:content';
import { url } from '../data/site';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul>
  {projects.map((project) => (
    <li class="border-t border-line py-7 first:border-t-0 first:pt-0 last:pb-0">
      <a href={url(`projects/${project.id}/`)} class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 gap-y-2">
        <h3 class="text-2xl font-bold tracking-tight transition-colors group-hover:text-accent sm:text-3xl">
          {project.data.title}
        </h3>
        <p class="text-muted">{project.data.date.getFullYear()}</p>
        <p class="col-span-2 max-w-[60ch] text-muted">
          {project.data.description}
          <span class="mt-1 block text-[0.9375rem] text-ink">{project.data.tags.join(', ')}</span>
        </p>
      </a>
    </li>
  ))}
</ul>
