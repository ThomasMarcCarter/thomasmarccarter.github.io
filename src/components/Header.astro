---
import { site, url } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

// Section anchors only exist on the home page, so point them there from other pages.
const isHome = Astro.url.pathname === url('/') || Astro.url.pathname === url('');
const initials = site.name.split(/[\s-]+/).map((part) => part[0]).join('');
const navHref =(href: string) => (href.startsWith('#') && !isHome ? url('/') + href : url(href));
---

<header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6" aria-label="Main">
    <a href={url('/')} class="font-semibold tracking-tight whitespace-nowrap text-zinc-900 dark:text-white" aria-label={`${site.name}, home`}>
      <span class="sm:hidden" aria-hidden="true">{initials}</span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-4">
      <ul class="flex items-center gap-3 text-sm sm:gap-6">
        {site.nav.map((item) => (
          <li>
            <a href={navHref(item.href)} class="text-zinc-600 transition hover:text-accent dark:text-zinc-400 dark:hover:text-accent">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
