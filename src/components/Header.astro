---
import { site, url } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

// Section anchors only exist on the home page, so point them there from other pages.
const isHome = Astro.url.pathname === url('/') || Astro.url.pathname === url('');
const navHref = (href: string) => (href.startsWith('#') && !isHome ? url('/') + href : url(href));
const initials = site.name.split(/[\s-]+/).map((part) => part[0]).join('');
---

<header class="mx-auto w-full max-w-6xl px-4 sm:px-8">
  <nav class="flex h-20 items-center justify-between gap-4" aria-label="Main">
    <a href={url('/')} class="font-bold tracking-tight whitespace-nowrap" aria-label={`${site.name}, home`}>
      <span class="sm:hidden" aria-hidden="true">{initials}</span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>
    <div class="flex items-center gap-2 sm:gap-6">
      <ul class="flex items-center gap-4 text-[0.9375rem] text-muted sm:gap-7">
        {site.nav.map((item) => (
          <li>
            <a href={navHref(item.href)} class="transition-colors hover:text-ink">{item.label}</a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
