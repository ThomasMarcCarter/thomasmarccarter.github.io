---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/site';
---

<BaseLayout title="Page not found">
  <section class="py-28 text-center">
    <p class="font-medium text-accent">404</p>
    <h1 class="mt-2 text-4xl font-bold text-zinc-900 dark:text-white">Page not found</h1>
    <p class="mt-4 text-zinc-600 dark:text-zinc-400">The page you're looking for doesn't exist.</p>
    <a href={url('/')} class="mt-8 inline-block rounded-lg bg-accent px-5 py-2.5 font-medium text-white hover:opacity-90">Go home</a>
  </section>
</BaseLayout>
