---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../data/site';
---

<BaseLayout title="Page not found">
  <section class="pt-20 pb-28 sm:pt-28">
    <h1 class="text-[clamp(2.75rem,8vw,5.5rem)] leading-[0.95] font-extrabold tracking-[-0.04em]">Page not found</h1>
    <p class="mt-6 max-w-[42ch] text-xl">This address doesn't match any page. Check the link, or go back to the home page.</p>
    <p class="mt-8"><a href={url('/')} class="link">Go to the home page</a></p>
  </section>
</BaseLayout>
