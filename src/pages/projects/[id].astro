---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, date, tags, repo, demo } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={description}>
  <article class="pt-12 pb-20 sm:pt-16">
    <a href={url('/#work')} class="link text-[0.9375rem] text-muted">Back to work</a>
    <h1 class="mt-10 text-[clamp(2.75rem,8vw,5.5rem)] leading-[0.95] font-extrabold tracking-[-0.04em]">{title}</h1>
    <p class="mt-6 max-w-[48ch] text-xl leading-snug sm:text-2xl">{description}</p>

    <dl class="mt-12 grid gap-6 border-t border-line pt-6 text-[0.9375rem] sm:grid-cols-3">
      <div>
        <dt class="text-muted">Year</dt>
        <dd class="mt-1"><time datetime={date.toISOString()}>{date.getFullYear()}</time></dd>
      </div>
      <div>
        <dt class="text-muted">Built with</dt>
        <dd class="mt-1">{tags.join(', ')}</dd>
      </div>
      {(repo || demo) && (
        <div>
          <dt class="text-muted">Links</dt>
          <dd class="mt-1 flex gap-5">
            {repo && <a href={repo} class="link" target="_blank" rel="noopener">Source code</a>}
            {demo && <a href={demo} class="link" target="_blank" rel="noopener">Live site</a>}
          </dd>
        </div>
      )}
    </dl>

    <div class="mt-14 max-w-[65ch] space-y-5 text-lg [&_a]:link [&_h2]:pt-6 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_li]:pl-1 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_ul]:marker:text-accent">
      <Content />
    </div>
  </article>
</BaseLayout>
